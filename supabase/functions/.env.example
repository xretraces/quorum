# Edge Function secrets. Local: copy to supabase/functions/.env. Remote: npx supabase secrets set --env-file <file>
GROK_API_KEY=xai-xxx            # XAI_API_KEY also accepted
GROK_MODEL=grok-4.7             # optional
GROK_IMAGE_MODEL=grok-imagine-image-2.0   # optional (recap-image)
GROK_STT_MODEL=grok-voice-transcribe-2.0  # optional (transcribe / Grok Voice)
STRIPE_SECRET_KEY=sk_test_xxx   # test keys only; pay refuses live keys unless ALLOW_LIVE_STRIPE=true
