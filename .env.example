# Quorum - Environment Variables
# Copy to .env.local and fill in your values

# Supabase (public values - safe to commit in .env.example)
VITE_SUPABASE_URL=https://oavxpwpdhdazhtieikju.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_OSB4uLU_Zsxi_HbdGLITZQ_uJvuy5UF

# Stripe (test mode publishable key - safe to commit)
# Missing or left as this placeholder => payments run in simulated mode (see README "Simulated payments").
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Force simulated payments even when Stripe is configured (rehearsals). No Stripe calls are made.
VITE_SIMULATE_PAYMENTS=false

# Where invite links and the lobby QR code point. Optional: defaults to the production site
# (https://quorum-eight-mu.vercel.app). Set to your LAN dev URL only to test joining a local build from a phone.
# VITE_PUBLIC_URL=http://192.168.1.20:5173

# Server secrets (set in Supabase Dashboard > Edge Functions > Secrets, NOT in this file):
# GROK_API_KEY=xai-...
# STRIPE_SECRET_KEY=sk_test_...
# GROK_MODEL=grok-4.7 (optional, this is the default)
